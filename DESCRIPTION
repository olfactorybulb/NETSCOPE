Package: NETSCOPE
Title: Information-Theoretic Network Construction and Analysis
Version: 0.1.0
Authors@R: c(
    person("Tansu", "Celikel", email = "celikel@gatech.edu", role = "aut"),
    person("Dingjing", "Shi", email = "dshi32@gatech.edu", role = "aut"),
    person("Chih-Chia", "Hsing", email = "jesscc.hsing@gmail.com", role = c("aut", "cre")),
