Package: NETSCOPE
Title: Information-Theoretic Network Construction and Analysis
Version: 0.1.0
Authors@R: c(
    person("Tansu", "Celikel", role = "aut"),
    person("Dingjing", "Shi", role = "aut"),
    person("Chih-Chia", "Hsing", email = "jesscc.hsing@gmail.com",
           role = c("aut", "cre")),
